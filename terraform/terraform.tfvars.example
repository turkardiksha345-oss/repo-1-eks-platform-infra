# eks-platform-infra/terraform/terraform.tfvars.example

aws_region   = "us-east-1"
environment  = "dev"
cluster_name = "eks-platform-dev"

vpc_cidr           = "10.0.0.0/16"
single_nat_gateway = true

system_node_desired_size   = 2
system_node_min_size       = 2
system_node_max_size       = 4
system_node_instance_types = ["t3.medium", "t3a.medium"]

frontend_repo_name = "frontend-app"
backend_repo_name  = "backend-app"

sender_email = "devops-alerts@yourdomain.com"
domain_name  = "" # Leave blank or specify "yourdomain.com"

create_github_oidc_provider = false # Set to false if token.actions.githubusercontent.com already exists in your AWS IAM
github_repo_subjects        = [
  "repo:my-github-org/frontend-app:*",
  "repo:my-github-org/backend-app:*",
  "repo:my-github-org/eks-platform-infra:*"
]

grafana_admin_password = "SuperSecureGrafanaPassword123!"

tags = {
  Project     = "Cloud-Native EKS Platform with GitOps, Autoscaling & Observability"
  Environment = "dev"
  ManagedBy   = "Terraform"
}
